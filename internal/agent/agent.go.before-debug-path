type Agent struct {
	Model string
	Max   int

	Root   string
	Router *tools.Router
	Ollama *ollama.Client

	State State

	ReadFiles       map[string]string
	InspectTree     string
	ResumeContext   string
	ProjectIndex    *projectindex.Index
	DependencyGraph *dependencygraph.Graph

	Wrote       bool
	DiffChecked bool

	History      []string
	ActionLedger []ActionRecord

	LastWritePath string
	LastTestError string
	RepairPath    string

	LastAction    string
	LastResult    string
	PendingAction *PendingAction
	Nudges        int

	TaskHash string
}

func New(root, model string, max int) *Agent {
	return &Agent{
		Model:     model,
		Max:       max,
		Root:      root,
		Router:    tools.New(root),
		Ollama:    ollama.New("http://127.0.0.1:11434"),
		State:     StateDiscover,
		ReadFiles: make(map[string]string),
	}
}

func (a *Agent) prompt(task string) string {
	var b strings.Builder

	b.WriteString("You are BRATAN GO, an autonomous local coding agent.\n")
	b.WriteString("You MUST use the available tools through TOOL_CALL.\n")
	b.WriteString("Never claim success without actual verification.\n")
	b.WriteString("The controller enforces the workflow. Do not repeat forbidden tools.\n")
	b.WriteString("Use the information from previous actions instead of rereading files unnecessarily.\n\n")

	b.WriteString("Current state: ")
	b.WriteString(string(a.State))
	b.WriteString("\n\n")

	b.WriteString("TASK:\n")
	b.WriteString(task)
	b.WriteString("\n\n")

	// Resume context is generated by the controller from persisted state.
	// Resume context is controller-generated and always current.
	a.ResumeContext = a.buildResumeContext()

	b.WriteString("RESUME CONTEXT:\n")
	b.WriteString(a.ResumeContext)
	b.WriteString("\n\n")
	b.WriteString("ACTION LEDGER:\n")
	b.WriteString(a.buildActionLedger())
	b.WriteString("\n\n")

	if a.InspectTree != "" {
		b.WriteString("PROJECT TREE DISCOVERED BY inspect_project:\n")
		b.WriteString(a.InspectTree)
		b.WriteString("\n\n")
	}

	if a.ProjectIndex != nil {
		b.WriteString("PROJECT INDEX:\n")

		for _, file := range a.ProjectIndex.Files {
			b.WriteString("FILE ")
			b.WriteString(file.Path)
			b.WriteString(" | type=")
			b.WriteString(file.Type)
			b.WriteString(" | language=")
			b.WriteString(file.Language)
			b.WriteString(" | size=")
			fmt.Fprintf(&b, " | bytes=%d", file.Size)
			b.WriteString("\n")
		}

		for _, symbol := range a.ProjectIndex.Symbols {
			b.WriteString("SYMBOL ")
			b.WriteString(symbol.File)
			b.WriteString(" | ")
			b.WriteString(symbol.Kind)
			b.WriteString(" ")
			b.WriteString(symbol.Name)
			b.WriteString("\n")
		}

		for _, relation := range a.ProjectIndex.Relations {
			b.WriteString("RELATION ")
			b.WriteString(relation.File)
			b.WriteString(" | ")
			b.WriteString(relation.Kind)
			b.WriteString(" -> ")
			b.WriteString(relation.Target)
			b.WriteString("\n")
		}

		b.WriteString("\n")
	}

	if a.DependencyGraph != nil {
		b.WriteString("DEPENDENCY GRAPH:\n")

		for _, file := range a.ProjectIndex.Files {
			deps := a.DependencyGraph.Dependencies(file.Path)

			if len(deps) == 0 {
				continue
			}

			b.WriteString(file.Path)
			b.WriteString(" -> ")
			b.WriteString(strings.Join(deps, ", "))
			b.WriteString("\n")
		}

		b.WriteString("\n")
	}

	if len(a.ReadFiles) > 0 {
		b.WriteString("FILES ALREADY READ:\n")

		for path, content := range a.ReadFiles {
			b.WriteString("\n--- FILE: ")
			b.WriteString(path)
			b.WriteString(" ---\n")
			b.WriteString(content)
			b.WriteString("\n--- END FILE: ")
			b.WriteString(path)
			b.WriteString(" ---\n")
		}

		b.WriteString("\n")
	}

	if a.LastAction != "" {
		b.WriteString("LAST ACTION:\n")
		b.WriteString(a.LastAction)
		b.WriteString("\n\n")
	}

	if a.LastResult != "" {
		b.WriteString("LAST ACTION RESULT:\n")
		b.WriteString(a.LastResult)
		b.WriteString("\n\n")
	}

	if a.LastTestError != "" {
		b.WriteString("LAST TEST FAILURE:\n")
		b.WriteString(a.LastTestError)
		b.WriteString("\n\n")
	}

	switch a.State {
	case StateDiscover:
		b.WriteString(
			"DISCOVERY PHASE.\n" +
				"Call inspect_project for the target project.\n",
		)

	case StateImplement:
		b.WriteString(
			"IMPLEMENTATION PHASE.\n" +
				"The project has already been inspected.\n" +
				"Do NOT call inspect_project again.\n" +
				"Read the relevant source files with read_file.\n" +
				"Use the information already provided in FILES ALREADY READ.\n" +
				"After understanding the files, call write_file.\n",
		)

	case StateWriteReq:
		b.WriteString(
			"WRITE_REQUIRED PHASE.\n" +
				"Enough source information has already been collected.\n" +
				"Do NOT call inspect_project.\n" +
				"Do NOT call read_file again.\n" +
				"Call write_file NOW.\n" +
				"Write the COMPLETE corrected file.\n",
		)

	case StateRepairRead:
		b.WriteString(
			"REPAIR_READ PHASE.\n" +
				"Verification failed.\n" +
				"The controller has already selected the failed source file.\n" +
				"Do not choose another tool.\n",
		)

	case StateRepairWrite:
		b.WriteString(
			"REPAIR_WRITE PHASE.\n" +
				"The failed source file has been read.\n" +
				"Analyze the actual test failure and the file contents.\n" +
				"Call write_file NOW with the complete corrected file.\n",
		)
	}

	b.WriteString(`
TOOL CALL FORMAT:

TOOL_CALL
name: TOOL_NAME
path: PATH
content: COMPLETE CONTENT
END_TOOL_CALL

AVAILABLE TOOLS:
inspect_project
read_file
write_file
git_diff
test
`)

	return b.String()
}

func (a *Agent) nudge(task string) string {
	var b strings.Builder

	b.WriteString(a.prompt(task))
	b.WriteString(`

NUDGE:
Your previous response did not contain a valid TOOL_CALL.

Do not explain what you would do.
Do not describe the solution.
Do not answer conversationally.

The controller requires an actual tool call NOW.

Current state is: `)
	b.WriteString(string(a.State))
	b.WriteString("\n")

	switch a.State {
	case StateDiscover:
		b.WriteString("Call inspect_project now.\n")

	case StateImplement:
		b.WriteString(
			"Call read_file for the next relevant source file, " +
				"or call write_file if the required source files have already been read.\n",
		)

	case StateWriteReq:
		b.WriteString("Call write_file now with the complete corrected file.\n")

	case StateRepairWrite:
		b.WriteString(
			"Call write_file now with the complete corrected repair.\n",
		)
	}

	b.WriteString(`
Return ONLY the TOOL_CALL block.

`)

	return b.String()
}

func (a *Agent) validateCompletion() error {
	hasInspect := false
	hasWrite := false
	hasDiff := false
	hasPass := false
	hasTestFail := false
	hasRepairRead := false
	hasRepairWrite := false

	lastWrite := 0
	lastDiff := 0
	lastPass := 0
	lastTest := 0
	lastTestFail := 0

	for _, item := range a.ActionLedger {
		/*
			Trust only ledger entries whose integrity can be
			recomputed from Tool + Args.
		*/
		if item.ActionKey == "" {
			continue
		}

		if makeActionKey(item.Tool, item.Args...) != item.ActionKey {
			continue
		}

		/*
			Test actions are inspected even when the test failed.
		*/
		if item.Tool == "test" {
			lastTest = item.Iteration

			if item.OK && item.Exit == 0 {
				if strings.Contains(item.Result, "PASS") {
					hasPass = true

					if item.Iteration > lastPass {
						lastPass = item.Iteration
					}
				}
			} else {
				if strings.Contains(item.Result, "WRONG:") ||
					strings.Contains(item.Result, "TEST FAILED") {
					hasTestFail = true

					if item.Iteration > lastTestFail {
						lastTestFail = item.Iteration
					}
				}
			}

			continue
		}

		if !item.OK || item.Exit != 0 {
			continue
		}

		switch item.Tool {
		case "inspect_project":
			hasInspect = true

		case "write_file":
			hasWrite = true

			if item.Iteration > lastWrite {
				lastWrite = item.Iteration
			}

		case "git_diff":
			hasDiff = true

			if item.Iteration > lastDiff {
				lastDiff = item.Iteration
			}

		case "repair_read":
			hasRepairRead = true

		case "repair_write":
			hasRepairWrite = true
		}
	}

	switch {
	case !hasInspect:
		return fmt.Errorf("completion blocked: inspect_project was not completed")

	case !hasWrite:
		return fmt.Errorf("completion blocked: write_file was not completed")

	case !hasDiff:
		return fmt.Errorf("completion blocked: git_diff was not completed")

	case !hasPass:
		return fmt.Errorf("completion blocked: successful test PASS was not recorded")

	case lastWrite >= lastDiff:
		return fmt.Errorf("completion blocked: final write must occur before final git_diff")

	case lastDiff >= lastPass:
		return fmt.Errorf("completion blocked: final git_diff must occur before final successful test")

	case lastTest != lastPass:
		return fmt.Errorf("completion blocked: successful test must be the final test action")
	}

	if hasTestFail {
		if !hasRepairRead {
			return fmt.Errorf("completion blocked: test failed but repair_read was not completed")
		}

		if !hasRepairWrite {
			return fmt.Errorf("completion blocked: test failed but repair_write was not completed")
		}
	}

	return nil
}
func (a *Agent) buildActionLedger() string {
	if len(a.ActionLedger) == 0 {
		return "none"
	}

	var b strings.Builder

	for i, item := range a.ActionLedger {
		fmt.Fprintf(&b, "%d. %s", i+1, item.Tool)

		if item.Result != "" {
			fmt.Fprintf(&b, " -> %s", strings.TrimSpace(item.Result))
		}

		if item.Error != "" {
			fmt.Fprintf(&b, " [error: %s]", strings.TrimSpace(item.Error))
		}

		b.WriteString("\n")
	}

	return strings.TrimSpace(b.String())
}

func (a *Agent) buildResumeContext() string {
	var b strings.Builder

	b.WriteString("Current state: ")
	b.WriteString(string(a.State))
	b.WriteString("\n")

	if a.InspectTree != "" {
		b.WriteString("Project inspection: completed\n")
	} else {
		b.WriteString("Project inspection: not completed\n")
	}

	if len(a.ReadFiles) > 0 {
		b.WriteString("Files already read: ")

		first := true
		for path := range a.ReadFiles {
			if !first {
				b.WriteString(", ")
			}

			b.WriteString(path)
			first = false
		}

		b.WriteString("\n")
	} else {
		b.WriteString("Files already read: none\n")
	}

	changed := make([]string, 0)

	for _, item := range a.History {
		switch {
		case strings.HasPrefix(item, "write_file:"):
			path := strings.TrimPrefix(item, "write_file:")
			if path != "" {
				changed = append(changed, path)
			}

		case strings.HasPrefix(item, "repair_write:"):
			path := strings.TrimPrefix(item, "repair_write:")
			if path != "" {
				changed = append(changed, path)
			}
		}
	}

	if len(changed) > 0 {
		b.WriteString("Files changed: ")
		b.WriteString(strings.Join(changed, ", "))
		b.WriteString("\n")
	} else {
		b.WriteString("Files changed: none\n")
	}

	if a.LastAction != "" {
		b.WriteString("Last action: ")
		b.WriteString(a.LastAction)
		b.WriteString("\n")
	}

	if a.LastResult != "" {
		b.WriteString("Last result is available from the previous action.\n")
	}

	if a.LastTestError != "" {
		b.WriteString("There is a previous test failure that must be considered during repair.\n")
	}

	switch a.State {
	case StateDiscover:
		b.WriteString("Next required phase: inspect_project\n")

	case StateImplement:
		b.WriteString("Next required phase: inspect/read relevant source, then write_file\n")

	case StateWriteReq:
		b.WriteString("Next required phase: write_file\n")

	case StateVerifyDiff:
		b.WriteString("Next required phase: git_diff\n")

	case StateTest:
		b.WriteString("Next required phase: test\n")

	case StateRepairRead:
		b.WriteString("Next required phase: read the controller-selected repair file\n")

	case StateRepairWrite:
		b.WriteString("Next required phase: write_file with the complete repair\n")

	case StateDone:
		b.WriteString("Next required phase: task already completed\n")
	}

	return b.String()
}

func (a *Agent) setResult(action, result string) {
	a.LastAction = action
	a.LastResult = result
}

func (a *Agent) recordAction(
	iteration int,
	tool string,
	result string,
	actionErr string,
	ok bool,
	exit int,
	args ...string,
) {
	storedArgs := append([]string(nil), args...)

	actionKey := ""
	if tool != "" {
		actionKey = makeActionKey(tool, storedArgs...)
	}

	a.ActionLedger = append(a.ActionLedger, ActionRecord{
		Iteration: iteration,
		Tool:      tool,
		ActionKey: actionKey,
		Args:      storedArgs,
		Result:    result,
		Error:     actionErr,
		OK:        ok,
		Exit:      exit,
	})
}

func (a *Agent) recordActionWithBaseHash(
	iteration int,
	tool string,
	result string,
	actionErr string,
	ok bool,
	exit int,
	baseHash string,
	args ...string,
) {
	a.recordAction(iteration, tool, result, actionErr, ok, exit, args...)

	if len(a.ActionLedger) == 0 {
		panic("recordActionWithBaseHash: action ledger is empty")
	}

	a.ActionLedger[len(a.ActionLedger)-1].BaseHash = baseHash
}

func makeActionKey(tool string, args ...string) string {
	h := sha256.New()

	h.Write([]byte(tool))
	for _, arg := range args {
		h.Write([]byte{0})
		h.Write([]byte(arg))
	}

	return hex.EncodeToString(h.Sum(nil))
}

func (a *Agent) hasSuccessfulAction(tool string, args ...string) (ActionRecord, bool) {
	if tool == "" {
		return ActionRecord{}, false
	}

	expectedKey := makeActionKey(tool, args...)

	for i := len(a.ActionLedger) - 1; i >= 0; i-- {
		record := a.ActionLedger[i]

		if !record.OK {
			continue
		}

		if record.ActionKey == "" {
			continue
		}

		if record.Tool != tool {
			continue
		}

		if record.ActionKey != expectedKey {
			continue
		}

		if len(record.Args) != len(args) {
			continue
		}

		match := true
		for j := range args {
			if record.Args[j] != args[j] {
				match = false
				break
			}
		}

		if !match {
			continue
		}

		if makeActionKey(record.Tool, record.Args...) != record.ActionKey {
			continue
		}

		return record, true
	}

	return ActionRecord{}, false
}

func clonePendingAction(src *PendingAction) *PendingAction {
	if src == nil {
		return nil
	}

	args := make(map[string]string, len(src.Args))
	for key, value := range src.Args {
		args[key] = value
	}

	return &PendingAction{
		Tool:     src.Tool,
		Args:     args,
		BaseHash: src.BaseHash,
	}
}

func (a *Agent) saveState(task string, iteration int) error {
	state := &TaskState{
		Version: taskStateVersion,

		Task:     task,
		TaskHash: taskHash(task),
		Project:  a.Root,

		State:         a.State,
		Iteration:     iteration,
		InspectTree:   a.InspectTree,
		ResumeContext: a.buildResumeContext(),
		ProjectIndex:  a.ProjectIndex,

		ReadFiles:    make(map[string]string),
		FileHashes:   make(map[string]string),
		ChangedFiles: make([]string, 0),

		LastWritePath: a.LastWritePath,
		LastTestError: a.LastTestError,
		RepairPath:    a.RepairPath,

		LastAction: a.LastAction,
		LastResult: a.LastResult,

		PendingAction: clonePendingAction(a.PendingAction),

		History:      append([]string(nil), a.History...),
		ActionLedger: append([]ActionRecord(nil), a.ActionLedger...),

		Wrote:       a.Wrote,
		DiffChecked: a.DiffChecked,
	}

	for path, content := range a.ReadFiles {
		state.ReadFiles[path] = content
		state.FileHashes[path] = contentHash(content)
	}

	// A written file may have changed after the original read.
	// Capture its actual current content as the resume baseline.
	if a.LastWritePath != "" {
		fullPath := filepath.Join(a.Root, filepath.Clean(a.LastWritePath))

		if data, err := os.ReadFile(fullPath); err == nil {
			state.FileHashes[a.LastWritePath] = contentHash(string(data))
		}
	}

	seen := make(map[string]bool)

	for _, item := range a.History {
		switch {
		case strings.HasPrefix(item, "write_file:"):
			path := strings.TrimPrefix(item, "write_file:")
			if path != "" && !seen[path] {
				state.ChangedFiles = append(state.ChangedFiles, path)
				seen[path] = true
			}

		case strings.HasPrefix(item, "repair_write:"):
			path := strings.TrimPrefix(item, "repair_write:")
			if path != "" && !seen[path] {
				state.ChangedFiles = append(state.ChangedFiles, path)
				seen[path] = true
			}
		}
	}

	return saveTaskState(a.Root, state)
}

func (a *Agent) restoreState(state *TaskState) {
	a.State = state.State
	a.InspectTree = state.InspectTree
	a.ResumeContext = state.ResumeContext
	a.ProjectIndex = state.ProjectIndex
	if a.ProjectIndex != nil {
		a.DependencyGraph = dependencygraph.Build(a.ProjectIndex)
	}

	a.ReadFiles = make(map[string]string)
	for path, content := range state.ReadFiles {
		a.ReadFiles[path] = content
	}

	a.Wrote = state.Wrote
	a.DiffChecked = state.DiffChecked

	a.History = append([]string(nil), state.History...)
	a.ActionLedger = append([]ActionRecord(nil), state.ActionLedger...)

	a.LastWritePath = state.LastWritePath
	a.LastTestError = state.LastTestError
	a.RepairPath = state.RepairPath

	a.LastAction = state.LastAction
	a.LastResult = state.LastResult
	a.PendingAction = clonePendingAction(state.PendingAction)

	a.TaskHash = state.TaskHash
}

func (a *Agent) Run(task string) error {
	if a.ReadFiles == nil {
		a.ReadFiles = make(map[string]string)
	}

	/*
		A resumed Run must continue the persisted iteration sequence.
		ActionLedger uses iteration numbers when validating ordering,
		so restarting the counter at 1 would make restored actions
		appear newer than actions performed before persistence.
	*/
	startIteration := 1

	/*
		Restore a previously saved task with the same task hash.

		This happens before the controller starts the FSM, so a
		completed task can terminate without calling Ollama again.
	*/
	if saved, ok, err := loadTaskState(a.Root, task); err != nil {
		return err
	} else if ok {
		fmt.Println("[BRATAN GO] persistent task state found")
		fmt.Printf(
			"[BRATAN GO] saved state=%s\n",
			saved.State,
		)

		reconciled, err := a.reconcile(saved)
		if err != nil {
			return err
		}

		if reconciled {
			a.restoreState(saved)

			/*
				Recover a write that completed physically but whose
				post-write checkpoint was lost in a crash. The filesystem
				was already validated against PendingAction by reconcile(),
				so never execute Router.Write() again.
			*/
			if a.PendingAction != nil {
				pending := a.PendingAction

				if pending.Tool == "write_file" ||
					pending.Tool == "repair_write" {
					path := pending.Args["path"]

					if path != "" {
						a.Wrote = true
						a.LastWritePath = path

						content := pending.Args["content"]

						a.recordActionWithBaseHash(
							saved.Iteration,
							pending.Tool,
							"recovered completed write",
							"",
							true,
							0,
							pending.BaseHash,
							path,
							content,
						)

						a.History = append(
							a.History,
							pending.Tool+":"+path,
						)

						a.setResult(
							pending.Tool+":"+path,
							"write recovered after crash",
						)

						a.PendingAction = nil
						a.State = StateVerifyDiff

						if err := a.saveState(
							task,
							saved.Iteration,
						); err != nil {
							return err
						}

						fmt.Printf(
							"[BRATAN GO] recovered pending write=%s\\n",
							path,
						)
					}
				}
			}

			startIteration = saved.Iteration + 1
			if startIteration < 1 {
				startIteration = 1
			}

			fmt.Printf(
				"[BRATAN GO] restored state=%s\n",
				a.State,
			)
			fmt.Printf(
				"[BRATAN GO] restored history=%v\n",
				a.History,
			)

			if saved.State == StateDone {
				fmt.Println("[BRATAN GO] task already completed")

				if a.LastTestError == "" ||
					strings.Contains(strings.ToUpper(a.LastResult), "PASS") {
					fmt.Println("[BRATAN GO] persisted result: PASS")
				}

				return nil
			}
		} else {
			fmt.Println(
				"[BRATAN GO] RECONCILE mismatch: saved state is stale",
			)
			fmt.Println(
				"[BRATAN GO] restarting from DISCOVER",
			)

			a.State = StateDiscover
			a.ReadFiles = make(map[string]string)
			a.InspectTree = ""
			a.Wrote = false
			a.DiffChecked = false
			a.History = nil
			a.ActionLedger = nil
			a.LastWritePath = ""
			a.LastTestError = ""
			a.RepairPath = ""
			a.LastAction = ""
			a.LastResult = ""
			a.Nudges = 0
		}

	}

	for iteration := startIteration; iteration <= a.Max; iteration++ {
		fmt.Printf(
			"\n[BRATAN GO] iteration=%d state=%s\n",
			iteration,
			a.State,
		)

		/*
			VERIFY_DIFF, TEST and REPAIR_READ are deterministic
			controller states. They must never ask the model
			what tool to call.
		*/
		switch a.State {

		case StateVerifyDiff:
			fmt.Println("[BRATAN GO] tool=git_diff")

			result := a.Router.GitDiff(".")
			a.recordAction(iteration, "git_diff", result.Output, result.Error, result.OK, result.Exit)

			if !result.OK {
				return fmt.Errorf(
					"git_diff: %s",
					result.Error,
				)
			}

			fmt.Print(result.Output)

			a.DiffChecked = true
			a.History = append(
				a.History,
				"git_diff",
			)

			a.setResult(
				"git_diff",
				result.Output,
			)

			a.State = StateTest

			if err := a.saveState(task, iteration); err != nil {
				return err
			}

			continue

		case StateTest:
			fmt.Println("[BRATAN GO] tool=test")

			path := "test.pl"

			result := a.Router.Test(path)
			a.recordAction(iteration, "test", result.Output, result.Error, result.OK, result.Exit, path)

			if result.Output != "" {
				fmt.Print(result.Output)
			}

			a.LastTestError = result.Output

			a.History = append(
				a.History,
				"test:"+path,
			)

			a.setResult(
				"test:"+path,
				result.Output,
			)

			if result.OK && result.Exit == 0 {
				if err := a.validateCompletion(); err != nil {
					return err
				}

				a.State = StateDone

				if err := a.saveState(task, iteration); err != nil {
					return err
				}

				fmt.Println("[BRATAN GO] TEST PASS")
				fmt.Printf(
					"[BRATAN GO] history=%v\n",
					a.History,
				)

				return nil
			}

			fmt.Println("[BRATAN GO] TEST FAILED")

			a.RepairPath = a.failedSourcePath(result.Output)

			if a.RepairPath == "" {
				a.RepairPath = a.LastWritePath
			}

			if a.RepairPath == "" {
				return fmt.Errorf(
					"test failed but could not determine source file to repair: %s",
					result.Output,
				)
			}

			fmt.Printf(
				"[BRATAN GO] repair target=%s\n",
				a.RepairPath,
			)

			a.State = StateRepairRead

			if err := a.saveState(task, iteration); err != nil {
				return err
			}

			continue

		case StateRepairRead:
			if a.RepairPath == "" {
				return fmt.Errorf(
					"REPAIR_READ entered without repair target",
				)
			}

			fmt.Printf(
				"[BRATAN GO] tool=read_file path=%s\n",
				a.RepairPath,
			)

			result := a.Router.Read(a.RepairPath)
			a.recordAction(iteration, "repair_read", result.Content, result.Error, result.OK, result.Exit, a.RepairPath)

			if !result.OK {
				return fmt.Errorf(
					"repair read failed for %s: %s",
					a.RepairPath,
					result.Error,
				)
			}

			a.ReadFiles[a.RepairPath] = result.Content

			a.History = append(
				a.History,
				"repair_read:"+a.RepairPath,
			)

			a.setResult(
				"repair_read:"+a.RepairPath,
				result.Content,
			)

			fmt.Printf(
				"[BRATAN GO] repair read %s (%d bytes)\n",
				a.RepairPath,
				len(result.Content),
			)

			a.State = StateRepairWrite

			if err := a.saveState(task, iteration); err != nil {
				return err
			}

			continue
		}

		/*
			All other states require a model decision.
		*/
		response, err := a.Ollama.Generate(
			a.Model,
			a.prompt(task),
		)

		if err != nil {
			return err
		}

		fmt.Printf("[BRATAN DEBUG RESPONSE]\n%s\n[BRATAN DEBUG RESPONSE END]\n", response)
		call, ok := parser.Parse(response)

		/*
			If the model returned no TOOL_CALL, immediately give it
			one corrective NUDGE inside the same controller iteration.
		*/
		if !ok {
			a.Nudges++

			fmt.Printf(
				"[BRATAN GO] model produced no tool call, NUDGE=%d\n",
				a.Nudges,
			)

			response, err = a.Ollama.Generate(
				a.Model,
				a.nudge(task),
			)

			if err != nil {
				return err
			}

			call, ok = parser.Parse(response)

			if !ok {
				fmt.Println(
					"[BRATAN GO] NUDGE also produced no tool call",
				)

				if a.Nudges >= 3 {
					return fmt.Errorf(
						"model failed to produce TOOL_CALL after %d nudges in state %s",
						a.Nudges,
						a.State,
					)
				}

				if err := a.saveState(task, iteration); err != nil {
					return err
				}

				continue
			}

			fmt.Printf(
				"[BRATAN GO] NUDGE accepted tool=%s\n",
				call.Name,
			)
		} else {
			a.Nudges = 0
		}

		fmt.Printf("[BRATAN GO] tool=%s\n", call.Name)

		switch a.State {

		case StateDiscover:
			if call.Name != "inspect_project" {
				fmt.Printf(
					"[BRATAN GO] blocked tool=%s in DISCOVER\n",
					call.Name,
				)
				continue
			}

			fmt.Printf("[BRATAN DEBUG PATH] %q\n", value(call.Args, "path", "."))
			result := a.Router.Inspect(
				value(call.Args, "path", "."),
				3,
			)
			a.recordAction(iteration, "inspect_project", result.Tree, result.Error, result.OK, result.Exit)

			if !result.OK {
				return fmt.Errorf(
					"inspect_project: %s",
					result.Error,
				)
			}

			a.InspectTree = result.Tree

			index, indexErr := projectindex.Build(a.Root)
			if indexErr != nil {
				return fmt.Errorf("project index: %s", indexErr)
			}

			a.ProjectIndex = index
			a.DependencyGraph = dependencygraph.Build(index)

			fmt.Printf(
				"[BRATAN GO] project index built: files=%d symbols=%d relations=%d\n",
				len(index.Files),
				len(index.Symbols),
				len(index.Relations),
			)

			fmt.Printf(
				"[BRATAN GO] dependency graph built: forward=%d reverse=%d\n",
				len(a.DependencyGraph.Forward),
				len(a.DependencyGraph.Reverse),
			)

			a.History = append(
				a.History,
				"inspect_project",
			)

			a.setResult(
				"inspect_project",
				result.Tree,
			)

			fmt.Println("[BRATAN GO] project inspected")
			fmt.Println(result.Tree)

			a.State = StateImplement

		case StateImplement:
			switch call.Name {

			case "inspect_project":
				fmt.Println(
					"[BRATAN GO] blocked repeated inspect_project",
				)
				continue

			case "read_file":
				path := value(call.Args, "path", "")

				if path == "" {
					fmt.Println(
						"[BRATAN GO] read_file without path",
					)
					continue
				}

				if _, alreadyRead := a.ReadFiles[path]; alreadyRead {
					fmt.Printf(
						"[BRATAN GO] repeated read: %s\n",
						path,
					)

					a.State = StateWriteReq

					if err := a.saveState(task, iteration); err != nil {
						return err
					}

					continue
				}

				result := a.Router.Read(path)
				a.recordAction(iteration, "read_file", result.Content, result.Error, result.OK, result.Exit, path)

				if !result.OK {
					fmt.Printf(
						"[BRATAN GO] read failed: %s\n",
						result.Error,
					)
					continue
				}

				a.ReadFiles[path] = result.Content

				a.History = append(
					a.History,
					"read_file:"+path,
				)

				a.setResult(
					"read_file:"+path,
					result.Content,
				)

				fmt.Printf(
					"[BRATAN GO] read %s (%d bytes)\n",
					path,
					len(result.Content),
				)

				if len(a.ReadFiles) >= 2 {
					a.State = StateWriteReq

					fmt.Println(
						"[BRATAN GO] state -> WRITE_REQUIRED",
					)
				}

			case "write_file":
				path := value(call.Args, "path", "")
				content := value(call.Args, "content", "")

				if path == "" || content == "" {
					fmt.Println(
						"[BRATAN GO] write_file missing path/content",
					)
					continue
				}

				if previous, duplicate := a.hasSuccessfulAction("write_file", path, content); duplicate {
					fmt.Printf(
						"[BRATAN GO] duplicate action skipped tool=%s path=%s iteration=%d\\n",
						"write_file",
						path,
						previous.Iteration,
					)

					a.Wrote = true
					a.LastWritePath = path
					a.History = append(
						a.History,
						"write_file:"+path,
					)
					a.setResult(
						"write_file:"+path,
						"identical successful action already recorded",
					)

					a.PendingAction = nil
					a.State = StateVerifyDiff

					if err := a.saveState(task, iteration); err != nil {
						return err
					}

					continue
				}

				baseContent, ok := a.ReadFiles[path]
				if !ok {
					return fmt.Errorf(
						"write_file path %q has no trusted read snapshot",
						path,
					)
				}

				baseHash := contentHash(baseContent)

				a.PendingAction = &PendingAction{
					Tool:     "write_file",
					BaseHash: baseHash,
					Args: map[string]string{
						"path":    path,
						"content": content,
					},
				}

				if err := a.saveState(task, iteration); err != nil {
					return err
				}

				result := a.Router.Write(path, content)
				a.recordActionWithBaseHash(
					iteration,
					"write_file",
					"write completed",
					result.Error,
					result.OK,
					result.Exit,
					baseHash,
					path,
					content,
				)
				a.PendingAction = nil

				if !result.OK {
					fmt.Printf(
						"[BRATAN GO] write failed: %s\n",
						result.Error,
					)
					continue
				}

				a.Wrote = true
				a.LastWritePath = path

				a.History = append(
					a.History,
					"write_file:"+path,
				)

				a.setResult(
					"write_file:"+path,
					"file written successfully",
				)

				a.State = StateVerifyDiff
			default:
				fmt.Printf(
					"[BRATAN GO] blocked tool=%s in IMPLEMENT\n",
					call.Name,
				)
			}

		case StateWriteReq:
			if call.Name != "write_file" {
				fmt.Printf(
					"[BRATAN GO] blocked tool=%s in WRITE_REQUIRED\n",
					call.Name,
				)
				continue
			}

			path := value(call.Args, "path", "")
			content := value(call.Args, "content", "")

			if path == "" {
				fmt.Println(
					"[BRATAN GO] write_file without path",
				)
				continue
			}

			if content == "" {
				fmt.Println(
					"[BRATAN GO] write_file without content",
				)
				continue
			}

			if previous, duplicate := a.hasSuccessfulAction("write_file", path, content); duplicate {
				fmt.Printf(
					"[BRATAN GO] duplicate action skipped tool=%s path=%s iteration=%d\\n",
					"write_file",
					path,
					previous.Iteration,
				)

				a.Wrote = true
				a.LastWritePath = path
				a.History = append(
					a.History,
					"write_file:"+path,
				)
				a.setResult(
					"write_file:"+path,
					"identical successful action already recorded",
				)

				a.PendingAction = nil
				a.State = StateVerifyDiff

				if err := a.saveState(task, iteration); err != nil {
					return err
				}

				continue
			}

			baseContent, ok := a.ReadFiles[path]
			if !ok {
				return fmt.Errorf(
					"write_file path %q has no trusted read snapshot",
					path,
				)
			}

			baseHash := contentHash(baseContent)

			a.PendingAction = &PendingAction{
				Tool:     "write_file",
				BaseHash: baseHash,
				Args: map[string]string{
					"path":    path,
					"content": content,
				},
			}

			if err := a.saveState(task, iteration); err != nil {
				return err
			}

			result := a.Router.Write(path, content)
			a.recordActionWithBaseHash(
				iteration,
				"write_file",
				"write completed",
				result.Error,
				result.OK,
				result.Exit,
				baseHash,
				path,
				content,
			)
			a.PendingAction = nil

			if !result.OK {
				fmt.Printf(
					"[BRATAN GO] write failed: %s\n",
					result.Error,
				)
				continue
			}

			a.Wrote = true
			a.LastWritePath = path

			a.History = append(
				a.History,
				"write_file:"+path,
			)

			a.setResult(
				"write_file:"+path,
				"file written successfully",
			)

			fmt.Printf(
				"[BRATAN GO] wrote %s\n",
				path,
			)

			a.State = StateVerifyDiff

		case StateRepairWrite:
			if call.Name != "write_file" {
				fmt.Printf(
					"[BRATAN GO] blocked tool=%s in REPAIR_WRITE\n",
					call.Name,
				)
				continue
			}

			path := value(call.Args, "path", "")

			if path == "" {
				path = a.RepairPath
			}

			content := value(call.Args, "content", "")

			if path == "" || content == "" {
				fmt.Println(
					"[BRATAN GO] repair write missing path/content",
				)
				continue
			}

			if previous, duplicate := a.hasSuccessfulAction("repair_write", path, content); duplicate {
				fmt.Printf(
					"[BRATAN GO] duplicate action skipped tool=%s path=%s iteration=%d\\n",
					"repair_write",
					path,
					previous.Iteration,
				)

				a.Wrote = true
				a.LastWritePath = path
				a.History = append(
					a.History,
					"repair_write:"+path,
				)
				a.setResult(
					"repair_write:"+path,
					"identical successful action already recorded",
				)

				a.PendingAction = nil
				a.State = StateVerifyDiff

				if err := a.saveState(task, iteration); err != nil {
					return err
				}

				continue
			}

			repairBaseHash := ""
			for i := len(a.ActionLedger) - 1; i >= 0; i-- {
				record := a.ActionLedger[i]
				if record.Tool != "repair_read" {
					continue
				}
				if !record.OK || record.Exit != 0 {
					continue
				}
				if len(record.Args) != 1 || record.Args[0] != path {
					continue
				}
				repairBaseHash = contentHash(record.Result)
				break
			}

			if repairBaseHash == "" {
				return fmt.Errorf(
					"repair_write path %q has no trusted repair_read snapshot",
					path,
				)
			}

			a.PendingAction = &PendingAction{
				Tool:     "repair_write",
				BaseHash: repairBaseHash,
				Args: map[string]string{
					"path":    path,
					"content": content,
				},
			}

			if err := a.saveState(task, iteration); err != nil {
				return err
			}

			result := a.Router.Write(path, content)
			a.recordActionWithBaseHash(
				iteration,
				"repair_write",
				"write completed",
				result.Error,
				result.OK,
				result.Exit,
				repairBaseHash,
				path,
				content,
			)
			a.PendingAction = nil

			if !result.OK {
				fmt.Printf(
					"[BRATAN GO] repair write failed: %s\n",
					result.Error,
				)
				continue
			}

			a.Wrote = true
			a.LastWritePath = path

			a.History = append(
				a.History,
				"repair_write:"+path,
			)

			a.setResult(
				"repair_write:"+path,
				"repair file written successfully",
			)

			a.State = StateVerifyDiff
		}

		if err := a.saveState(task, iteration); err != nil {
			return err
		}
	}

	return fmt.Errorf(
		"agent stopped after %d iterations in state %s",
		a.Max,
		a.State,
	)
}

func (a *Agent) failedSourcePath(output string) string {
	/*
		Examples:
		  ./math.pl did not return a true value at ...
		  math.pl: ...
		  ./src/foo.pl: ...
	*/
	re := regexp.MustCompile(`(?:^|\s)(\.?/?[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*\.pl)(?:\s|:|$)`)

	matches := re.FindStringSubmatch(output)

	if len(matches) > 1 {
		path := strings.TrimPrefix(matches[1], "./")

		/*
			If the failing test file is known by the dependency graph,
			repair the source file it depends on.
		*/
		if a.DependencyGraph != nil {
			deps := a.DependencyGraph.Dependencies(path)

			if len(deps) > 0 {
				return deps[0]
			}
		}

		return path
	}

	/*
		If the test output does not explicitly name a .pl file,
		prefer the most recently written file.
	*/
	if a.LastWritePath != "" {
		return a.LastWritePath
	}

	return ""
}

func value(args map[string]string, key, fallback string) string {
	if v, ok := args[key]; ok && v != "" {
		return v
	}

	if key == "path" {
		if v, ok := args["arg"]; ok && v != "" {
			return v
		}

		if v, ok := args["file"]; ok && v != "" {
			return v
		}
	}

	return fallback
}
